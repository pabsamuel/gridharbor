{
  "manifest_version":3,"name":"GridHarbor — local table workbench","short_name":"GridHarbor","version":"0.1.0",
  "description":"Capture visible tables locally. Clean, select columns and export CSV, TSV, JSON or Markdown without an account.",
  "minimum_chrome_version":"116","permissions":["activeTab","scripting","storage"],
  "action":{"default_title":"Capture tables with GridHarbor"},
  "background":{"service_worker":"background.js","type":"module"},
  "icons":{"16":"icons/icon-16.png","32":"icons/icon-32.png","48":"icons/icon-48.png","128":"icons/icon-128.png"},
  "content_security_policy":{"extension_pages":"script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"}
}
